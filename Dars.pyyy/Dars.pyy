#21
while True:
    print("\n1. Salomlashish")
    print("2. Sonlarni chiqarish")
    print("3. Juft sonlar")
    print("4. Chiqish")

    tanlov = int(input("Tanlang: "))

    if tanlov == 1:
        print("Salom!")

    elif tanlov == 2:
        c = 1
        while c <= 10:
            print(c)
            c += 1

    elif tanlov == 3:
        c = 2
        while c <= 20:
            print(c)
            c += 2


    